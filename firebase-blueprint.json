{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Learner progress profile including XP, daily streak, hearts, HSK level, and completed units.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated user UID."
        },
        "displayName": {
          "type": "string",
          "description": "Learner display name."
        },
        "xp": {
          "type": "integer",
          "description": "Total earned experience points."
        },
        "streak": {
          "type": "integer",
          "description": "Daily learning streak count."
        },
        "hearts": {
          "type": "integer",
          "description": "Current lesson hearts (0 to 5)."
        },
        "currentHskLevel": {
          "type": "integer",
          "description": "Current HSK 3.0 target level (1 to 9)."
        },
        "completedUnitIds": {
          "type": "array",
          "description": "List of completed learning path unit IDs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp() on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp() on updates."
        }
      },
      "required": [
        "userId",
        "displayName",
        "xp",
        "streak",
        "hearts",
        "currentHskLevel",
        "completedUnitIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomWord": {
      "title": "CustomWord",
      "description": "User-imported or AI-generated HSK 3.0 vocabulary word.",
      "type": "object",
      "properties": {
        "hanzi": {
          "type": "string",
          "description": "Simplified Chinese characters."
        },
        "pinyin": {
          "type": "string",
          "description": "Pinyin with tone marks."
        },
        "english": {
          "type": "string",
          "description": "English translation."
        },
        "hskLevel": {
          "type": "integer",
          "description": "HSK 3.0 level from 1 to 9."
        },
        "topicId": {
          "type": "integer",
          "description": "Topic ID from 1 to 14."
        },
        "writable": {
          "type": "boolean",
          "description": "Whether the word is marked writable."
        },
        "exampleHanzi": {
          "type": "string",
          "description": "Example sentence in Hanzi."
        },
        "examplePinyin": {
          "type": "string",
          "description": "Example sentence in Pinyin."
        },
        "exampleEnglish": {
          "type": "string",
          "description": "Example sentence in English."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "hanzi",
        "pinyin",
        "english",
        "hskLevel",
        "topicId",
        "writable",
        "exampleHanzi",
        "examplePinyin",
        "exampleEnglish",
        "createdAt",
        "updatedAt"
      ]
    },
    "SrsCard": {
      "title": "SrsCard",
      "description": "SuperMemo SM-2 spaced repetition flashcard state for a Chinese vocabulary item.",
      "type": "object",
      "properties": {
        "wordKey": {
          "type": "string",
          "description": "Stable identifier for the vocabulary item."
        },
        "hanzi": {
          "type": "string",
          "description": "Simplified Chinese characters."
        },
        "pinyin": {
          "type": "string",
          "description": "Pinyin pronunciation."
        },
        "english": {
          "type": "string",
          "description": "English meaning."
        },
        "hskLevel": {
          "type": "integer",
          "description": "HSK 3.0 level (1 to 9)."
        },
        "exampleHanzi": {
          "type": "string",
          "description": "Example sentence in Chinese."
        },
        "repetitions": {
          "type": "integer",
          "description": "Consecutive successful SM-2 repetitions."
        },
        "intervalDays": {
          "type": "integer",
          "description": "Current SM-2 interval in days."
        },
        "easeFactor": {
          "type": "number",
          "description": "SM-2 ease factor (1.3 to 5.0)."
        },
        "lapses": {
          "type": "integer",
          "description": "Number of missed reviews; triggers AI mnemonic rescue at 3+."
        },
        "nextReviewEpochMs": {
          "type": "integer",
          "description": "UTC epoch millis when card is next due."
        },
        "mnemonicHint": {
          "type": "string",
          "description": "Optional AI-generated mnemonic rescue hint."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "wordKey",
        "hanzi",
        "pinyin",
        "english",
        "hskLevel",
        "exampleHanzi",
        "repetitions",
        "intervalDays",
        "easeFactor",
        "lapses",
        "nextReviewEpochMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedStory": {
      "title": "SavedStory",
      "description": "AI-generated graded Chinese reading story with comprehension quiz.",
      "type": "object",
      "properties": {
        "titleZh": {
          "type": "string",
          "description": "Story title in Hanzi."
        },
        "titleEn": {
          "type": "string",
          "description": "Story title in English."
        },
        "hskLevel": {
          "type": "integer",
          "description": "HSK 3.0 level (1 to 9)."
        },
        "topicName": {
          "type": "string",
          "description": "Topic category name."
        },
        "sentences": {
          "type": "array",
          "description": "List of sentence objects with zh, pinyin, and en fields."
        },
        "quizQuestion": {
          "type": "string",
          "description": "Comprehension question."
        },
        "quizOptions": {
          "type": "array",
          "description": "Multiple choice answer options."
        },
        "quizCorrectIndex": {
          "type": "integer",
          "description": "Zero-based index of the correct answer."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "titleZh",
        "titleEn",
        "hskLevel",
        "topicName",
        "sentences",
        "quizQuestion",
        "quizOptions",
        "quizCorrectIndex",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores each learner's HSK 3.0 progress profile (XP, streak, hearts, completed units)."
    },
    "/users/{userId}/custom_words/{wordId}": {
      "schema": {
        "$ref": "#/entities/CustomWord"
      },
      "description": "Stores AI-generated and CSV-imported HSK 3.0 vocabulary words owned by the user."
    },
    "/users/{userId}/srs_cards/{cardId}": {
      "schema": {
        "$ref": "#/entities/SrsCard"
      },
      "description": "Stores SuperMemo SM-2 spaced repetition flashcard state per user."
    },
    "/users/{userId}/saved_stories/{storyId}": {
      "schema": {
        "$ref": "#/entities/SavedStory"
      },
      "description": "Stores AI-generated graded stories saved by the user."
    }
  }
}
