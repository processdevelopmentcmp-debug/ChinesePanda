    /* ==================== GEMINI API CALLER ==================== */
    async function callGeminiAPI(userQuery, systemInstruction = "") {
      const apiKey = "";
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const payload = {
        contents: [{ parts: [{ text: userQuery }] }],
        systemInstruction: { parts: [{ text: systemInstruction || "You are Panda Laoshi, an expert Chinese language teacher." }] }
      };

      try {
        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        return data.candidates?.[0]?.content?.parts?.[0]?.text || "Panda Laoshi is thinking... please try again!";
      } catch (err) {
        console.error("Gemini API Error:", err);
        return "Panda Laoshi offline fallback: Chinese grammar follows SVO structure! Try asking again shortly.";
      }
    }

