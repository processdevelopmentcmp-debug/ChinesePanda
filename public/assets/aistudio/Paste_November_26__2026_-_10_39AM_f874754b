CREATE TABLE hsk_words (
    id SERIAL PRIMARY KEY,
    hanzi VARCHAR(16) NOT NULL,
    pinyin VARCHAR(64) NOT NULL,
    english TEXT NOT NULL,
    hsk_level INT NOT NULL, -- 1 to 9
    topic_id INT NOT NULL,
    is_writable BOOLEAN DEFAULT TRUE,
