      document.getElementById('srs-card-en').innerText = card.english;
      document.getElementById('srs-card-ex').innerText = `"${card.exHanzi || ''}"`;

      document.getElementById('srs-card-back').classList.add('hidden');
      document.getElementById('srs-quality-group').classList.add('hidden');
      document.getElementById('srs-flip-btn').classList.remove('hidden');
    }

    function flipSRSCard() {
      document.getElementById('srs-card-back').classList.remove('hidden');
      document.getElementById('srs-quality-group').classList.remove('hidden');
      document.getElementById('srs-flip-btn').classList.add('hidden');
    }

    function answerSRS(q) {
      const card = STATE.sm2Deck.shift();
      if (q >= 3) addXP(15);
      renderSRSCard();
    }

    /* ==================== GAMIFICATION & UTILS ==================== */
    function addXP(val) {
      STATE.xp += val;
      localStorage.setItem('panda_xp', STATE.xp);
      document.getElementById('header-xp').innerText = STATE.xp;
    }

    function openBlueprintModal() { document.getElementById('modal-blueprint').classList.remove('hidden'); }
    function closeBlueprintModal() { document.getElementById('modal-blueprint').classList.add('hidden'); }
    function openAIGeneratorModal() { document.getElementById('modal-ai-generator').classList.remove('hidden'); }
    function closeAIGeneratorModal() { document.getElementById('modal-ai-generator').classList.add('hidden'); }
    function openImporterModal() { document.getElementById('modal-importer').classList.remove('hidden'); }
    function closeImporterModal() { document.getElementById('modal-importer').classList.add('hidden'); }

    // On Window Load
    window.onload = function() {
      populateTopicDropdowns();
      renderTopicsModule();
    };
  </script>
</body>
</html>