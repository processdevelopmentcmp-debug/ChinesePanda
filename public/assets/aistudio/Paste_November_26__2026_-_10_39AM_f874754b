<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PandaChinese Pro — HSK 3.0 Complete Mastery Suite</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#F4FBF8',
              100: '#E6F7F1',
              400: '#2ECD99',
              500: '#00B894',
              600: '#00A383',
              700: '#00896E',
              900: '#004D3E',
            },
            gold: {
              400: '#FDCB6E',
              500: '#E1B12C',
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
            kai: ['Kaiti SC', 'STKaiti', 'KaiTi', 'DFKai-SB', 'serif']
          }
        }
      }
    }
  </script>

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Hanzi Writer CDN -->
  <script src="https://cdn.jsdelivr.net/npm/hanzi-writer@3.5/dist/hanzi-writer.min.js"></script>

  <style>
    /* Custom Scrollbars & Animations */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    
    .btn-3d {
      transition: all 0.1s ease;
      box-shadow: 0 4px 0 rgba(0,0,0,0.15);
    }
    .btn-3d:active {
      transform: translateY(3px);
      box-shadow: 0 1px 0 rgba(0,0,0,0.15);
    }
    
    /* Mi Zi Ge Background Grid for Character Writing */
    .mizige-bg {
      background-color: #ffffff;
      background-image: 
        linear-gradient(to right, #fecaca 1px, transparent 1px),
        linear-gradient(to bottom, #fecaca 1px, transparent 1px),
        linear-gradient(to top right, transparent calc(50% - 0.5px), #fee2e2 50%, transparent calc(50% + 0.5px)),
        linear-gradient(to bottom right, transparent calc(50% - 0.5px), #fee2e2 50%, transparent calc(50% + 0.5px));
      background-size: 100% 100%;
      border: 2px solid #ef4444;
    }

    @keyframes pulse-subtle {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }
    .panda-bounce { animation: pulse-subtle 3s infinite ease-in-out; }
  </style>
</head>
<body class="bg-brand-50 text-slate-800 min-h-screen font-sans flex flex-col">

  <!-- ==================== HEADER BAR ==================== -->
  <header class="bg-white border-b border-brand-100 shadow-sm sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-3">
      
      <!-- Logo & Title -->
      <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('topics')">
        <!-- SVG Panda Mascot Icon -->
        <div class="w-11 h-11 bg-brand-50 rounded-full flex items-center justify-center p-1 border-2 border-brand-500 shadow-inner">
          <svg viewBox="0 0 100 100" class="w-full h-full panda-bounce">
            <!-- Ears -->
            <circle cx="22" cy="22" r="14" fill="#2d3748" />
            <circle cx="78" cy="22" r="14" fill="#2d3748" />
            <!-- Head -->
            <circle cx="50" cy="52" r="38" fill="#ffffff" stroke="#e2e8f0" stroke-width="2" />
            <!-- Eye Patches -->
            <ellipse cx="33" cy="48" rx="11" ry="14" fill="#2d3748" transform="rotate(-15 33 48)" />
            <ellipse cx="67" cy="48" rx="11" ry="14" fill="#2d3748" transform="rotate(15 67 48)" />
            <!-- Eyes -->
            <circle cx="35" cy="47" r="4" fill="#ffffff" />
            <circle cx="65" cy="47" r="4" fill="#ffffff" />
            <circle cx="36" cy="47" r="2" fill="#000000" />
            <circle cx="64" cy="47" r="2" fill="#000000" />
            <!-- Nose & Mouth -->
            <ellipse cx="50" cy="58" rx="6" ry="4" fill="#2d3748" />
            <path d="M 45 64 Q 50 68 55 64" fill="none" stroke="#2d3748" stroke-width="2.5" stroke-linecap="round" />
            <!-- Cheeks -->
            <ellipse cx="25" cy="58" rx="6" ry="3" fill="#f472b6" opacity="0.5" />
            <ellipse cx="75" cy="58" rx="6" ry="3" fill="#f472b6" opacity="0.5" />
          </svg>
        </div>
        <div>
          <h1 class="text-xl font-bold text-slate-800 tracking-tight flex items-center gap-2">
            <span>PandaChinese <span class="text-brand-500 font-extrabold">Pro</span></span>
            <span class="bg-gradient-to-r from-brand-500 to-emerald-700 text-white text-xs px-2 py-0.5 rounded-full uppercase tracking-wider font-semibold">HSK 3.0</span>
          </h1>
          <p class="text-xs text-slate-500 hidden sm:block">Master all 9 HSK 3.0 Levels · Topic-by-Topic</p>
        </div>
      </div>

      <!-- Gamified Status Bar -->
      <div class="flex items-center space-x-2 sm:space-x-4 text-sm font-semibold">
        <!-- Streak -->
        <div class="flex items-center space-x-1.5 bg-amber-50 text-amber-700 px-3 py-1.5 rounded-full border border-amber-200" title="Daily Streak">
          <i class="fa-solid font-900 fa-fire text-amber-500 animate-pulse"></i>
          <span id="header-streak">5</span> <span class="text-xs hidden sm:inline">Days</span>
        </div>

        <!-- XP -->
        <div class="flex items-center space-x-1.5 bg-emerald-50 text-brand-700 px-3 py-1.5 rounded-full border border-emerald-200" title="Total XP">
          <i class="fa-solid fa-bolt text-brand-500"></i>
          <span id="header-xp">350</span> <span class="text-xs hidden sm:inline">XP</span>
        </div>

        <!-- Hearts -->
        <div class="flex items-center space-x-1 bg-rose-50 text-rose-600 px-3 py-1.5 rounded-full border border-rose-200" title="Hearts">
          <i class="fa-solid fa-heart text-rose-500"></i>
          <span id="header-hearts">5</span>/5
        </div>

        <!-- Due SRS Badge -->
        <button onclick="switchTab('review')" class="flex items-center space-x-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 px-3 py-1.5 rounded-full border border-indigo-200 transition" title="Due for SM-2 Review">
          <i class="fa-solid fa-brain text-indigo-500"></i>
          <span id="header-due-count" class="bg-indigo-600 text-white text-xs px-1.5 py-0.2 rounded-full font-bold">12</span>
        </button>

        <!-- Header Action Buttons -->
        <button onclick="switchTab('teacher')" class="bg-brand-500 hover:bg-brand-600 text-white px-3 py-1.5 rounded-xl font-bold text-xs flex items-center gap-1.5 border-b-2 border-brand-700 btn-3d shadow-sm">
          <span>🐼 Ask Teacher</span>
        </button>
        <button onclick="openBlueprintModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded-xl text-xs font-bold border border-slate-300" title="Dev Blueprint & Schema">
          <i class="fa-solid fa-code"></i>
        </button>
      </div>

    </div>

    <!-- ==================== TAB NAVIGATION ==================== -->
    <nav class="bg-slate-900 text-white px-2 py-1 shadow-inner overflow-x-auto scrollbar-none">
      <div class="max-w-7xl mx-auto flex items-center space-x-1 min-w-max text-xs sm:text-sm font-medium">
        <button onclick="switchTab('topics')" id="nav-topics" class="tab-btn active-tab px-3 py-2 rounded-lg flex items-center gap-2 hover:bg-slate-800 transition">
          <span>📚 HSK 3.0 Topics</span>
        </button>
        <button onclick="switchTab('teacher')" id="nav-teacher" class="tab-btn px-3 py-2 rounded-lg flex items-center gap-2 hover:bg-slate-800 transition">
          <span>🐼 AI Teacher</span>
        </button>
        <button onclick="switchTab('learnpath')" id="nav-learnpath" class="tab-btn px-3 py-2 rounded-lg flex items-center gap-2 hover:bg-slate-800 transition">
          <span>🎯 Learn Path</span>
        </button>
        <button onclick="switchTab('sentences')" id="nav-sentences" class="tab-btn px-3 py-2 rounded-lg flex items-center gap-2 hover:bg-slate-800 transition">
          <span>🧩 Sentences</span>
        </button>
        <button onclick="switchTab('listening')" id="nav-listening" class="tab-btn px-3 py-2 rounded-lg flex items-center gap-2 hover:bg-slate-800 transition">
          <span>🎧 Listening Test</span>
        </button>
        <button onclick="switchTab('write')" id="nav-write" class="tab-btn px-3 py-2 rounded-lg flex items-center gap-2 hover:bg-slate-800 transition">
          <span>✍️ Write</span>
        </button>
        <button onclick="switchTab('speak')" id="nav-speak" class="tab-btn px-3 py-2 rounded-lg flex items-center gap-2 hover:bg-slate-800 transition">
          <span>🎙️ Speak</span>
        </button>
        <button onclick="switchTab('stories')" id="nav-stories" class="tab-btn px-3 py-2 rounded-lg flex items-center gap-2 hover:bg-slate-800 transition">
          <span>📖 Stories</span>
        </button>
        <button onclick="switchTab('review')" id="nav-review" class="tab-btn px-3 py-2 rounded-lg flex items-center gap-2 hover:bg-slate-800 transition">
          <span>🧠 Review (SM-2)</span>
        </button>
        <button onclick="switchTab('radicals')" id="nav-radicals" class="tab-btn px-3 py-2 rounded-lg flex items-center gap-2 hover:bg-slate-800 transition">
          <span>🧱 Radicals</span>
        </button>
      </div>
    </nav>
  </header>

  <!-- ==================== MAIN CONTENT CONTAINER ==================== -->
  <main class="max-w-7xl mx-auto px-4 py-6 flex-grow w-full">

    <!-- 1. HSK 3.0 TOPICS TAB -->
    <section id="tab-topics" class="tab-content space-y-6">
      
      <!-- HSK 3.0 Standard Level Tracker Banner -->
      <div class="bg-gradient-to-r from-brand-700 via-brand-600 to-emerald-900 text-white p-5 rounded-2xl shadow-lg flex flex-col lg:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-gold-400">
            <i class="fa-solid fa-certificate"></i> Official HSK 3.0 Standard Syllabus (11,000 Words Target)
          </div>
          <h2 class="text-2xl font-black">HSK 3.0 Level Curriculum Roadmap</h2>
          <p class="text-xs sm:text-sm text-brand-100 max-w-2xl">
            Explore complete topic-by-topic wordlists for Level 1, 2, and 3, plus import or generate Level 4–9 wordpacks powered by AI!
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="openAIGeneratorModal()" class="bg-gold-400 hover:bg-gold-500 text-slate-900 px-4 py-2.5 rounded-xl font-extrabold text-xs sm:text-sm border-b-4 border-amber-600 btn-3d flex items-center gap-2">
            <i class="fa-solid fa-wand-magic-sparkles"></i> AI Topic Pack Generator
          </button>
          <button onclick="openImporterModal()" class="bg-white/10 hover:bg-white/20 text-white px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm border border-white/30 flex items-center gap-2">
            <i class="fa-solid fa-file-import"></i> Bulk Import CSV/JSON
          </button>
        </div>
      </div>

      <!-- HSK 3.0 9-Level Tracker Chips -->
      <div class="grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-9 gap-2 text-center text-xs font-semibold">
        <div class="bg-white p-2 rounded-xl border-2 border-brand-500 shadow-sm">
          <div class="text-brand-600 font-extrabold">HSK 1</div>
          <div class="text-slate-500 text-[10px]">300 words</div>
          <div class="mt-1 bg-brand-100 rounded-full h-1.5"><div class="bg-brand-500 h-1.5 rounded-full" style="width: 100%"></div></div>
        </div>
        <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm">
          <div class="text-slate-800 font-bold">HSK 2</div>
          <div class="text-slate-500 text-[10px]">+200 (500 cum.)</div>
          <div class="mt-1 bg-slate-100 rounded-full h-1.5"><div class="bg-brand-500 h-1.5 rounded-full" style="width: 75%"></div></div>
        </div>
        <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm">
          <div class="text-slate-800 font-bold">HSK 3</div>
          <div class="text-slate-500 text-[10px]">+500 (1k cum.)</div>
          <div class="mt-1 bg-slate-100 rounded-full h-1.5"><div class="bg-brand-500 h-1.5 rounded-full" style="width: 45%"></div></div>
        </div>
        <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm">
          <div class="text-slate-800 font-bold">HSK 4</div>
          <div class="text-slate-500 text-[10px]">+1,000 (2k)</div>
          <div class="mt-1 bg-slate-100 rounded-full h-1.5"><div class="bg-brand-500 h-1.5 rounded-full" style="width: 20%"></div></div>
        </div>
        <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm">
          <div class="text-slate-800 font-bold">HSK 5</div>
          <div class="text-slate-500 text-[10px]">+1,600 (3.6k)</div>
          <div class="mt-1 bg-slate-100 rounded-full h-1.5"><div class="bg-brand-500 h-1.5 rounded-full" style="width: 10%"></div></div>
        </div>
        <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm">
          <div class="text-slate-800 font-bold">HSK 6</div>
          <div class="text-slate-500 text-[10px]">+1,800 (5.4k)</div>
          <div class="mt-1 bg-slate-100 rounded-full h-1.5"><div class="bg-brand-500 h-1.5 rounded-full" style="width: 5%"></div></div>
        </div>
        <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm col-span-3 sm:col-span-2 lg:col-span-3">
          <div class="text-purple-600 font-extrabold">HSK 7–9 Advanced</div>
          <div class="text-slate-500 text-[10px]">+5,600 (11,000 Total)</div>
          <div class="mt-1 bg-slate-100 rounded-full h-1.5"><div class="bg-purple-500 h-1.5 rounded-full" style="width: 2%"></div></div>
        </div>
      </div>

      <!-- Filters & Topic Controls -->
      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
        
        <!-- Level Pills -->
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-xs font-bold text-slate-400 mr-1">LEVEL:</span>
          <button onclick="setTopicLevelFilter('ALL')" id="lvl-pill-ALL" class="lvl-pill active-lvl bg-brand-500 text-white px-3 py-1 rounded-lg text-xs font-bold">All</button>
          <button onclick="setTopicLevelFilter('1')" id="lvl-pill-1" class="lvl-pill bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1 rounded-lg text-xs font-bold">HSK 1</button>
          <button onclick="setTopicLevelFilter('2')" id="lvl-pill-2" class="lvl-pill bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1 rounded-lg text-xs font-bold">HSK 2</button>
          <button onclick="setTopicLevelFilter('3')" id="lvl-pill-3" class="lvl-pill bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1 rounded-lg text-xs font-bold">HSK 3</button>
          <button onclick="setTopicLevelFilter('ADV')" id="lvl-pill-ADV" class="lvl-pill bg-slate-100 text-slate-700 hover:bg-slate-200 px-3 py-1 rounded-lg text-xs font-bold">HSK 4–9</button>
        </div>

        <!-- Search & Writable Toggle -->
        <div class="flex items-center gap-3">
          <div class="relative flex-1 sm:w-64">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
            <input type="text" id="topic-search-input" oninput="renderTopicsModule()" placeholder="Search Hanzi, Pinyin or English..." class="w-full pl-9 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
          <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-600 select-none">
            <input type="checkbox" id="writable-only-chk" onchange="renderTopicsModule()" class="rounded text-brand-500 focus:ring-brand-500">
            <span>Writable Only</span>
          </label>
        </div>

      </div>

      <!-- Active Selected Topic Dashboard (if a topic is clicked) -->
      <div id="topic-detail-dashboard" class="hidden bg-white p-5 rounded-2xl border-2 border-brand-500 shadow-md space-y-4">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-slate-100 pb-4">
          <div>
            <div class="flex items-center gap-2">
              <span id="topic-detail-icon" class="text-3xl">💬</span>
              <div>
                <h3 id="topic-detail-title" class="text-xl font-black text-slate-800">Greetings & Pronouns</h3>
                <p id="topic-detail-count" class="text-xs text-slate-500">30 Vocabulary Words</p>
              </div>
            </div>
          </div>
          
          <div class="flex flex-wrap items-center gap-2">
            <button onclick="launchTopicAITeacher()" class="bg-brand-500 hover:bg-brand-600 text-white px-3 py-2 rounded-xl text-xs font-bold border-b-2 border-brand-700 btn-3d">
              🐼 AI Topic Lesson
            </button>
            <button onclick="launchTopicListeningTest()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-xl text-xs font-bold border-b-2 border-indigo-800 btn-3d">
              🎧 Topic Listening
            </button>
            <button onclick="launchTopicSentenceStudio()" class="bg-amber-500 hover:bg-amber-600 text-slate-900 px-3 py-2 rounded-xl text-xs font-bold border-b-2 border-amber-700 btn-3d">
              🧩 Sentence Practice
            </button>
            <button onclick="closeTopicDashboard()" class="text-slate-400 hover:text-slate-600 p-2 text-lg">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        </div>

        <!-- Word Grid for Selected Topic -->
        <div id="topic-words-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Topics Grid Selection -->
      <div id="topics-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <!-- Dynamically Rendered Topics Cards -->
      </div>

    </section>

    <!-- 2. 🐼 AI TEACHING ASSISTANT TAB (Panda Laoshi) -->
    <section id="tab-teacher" class="tab-content hidden space-y-6">
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left Column: Topic Lesson Selector & Quick Prompts -->
        <div class="space-y-4">
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3">
            <h3 class="font-extrabold text-slate-800 flex items-center gap-2">
              <i class="fa-solid fa-graduation-cap text-brand-500"></i> Interactive Topic Lesson
            </h3>
            <p class="text-xs text-slate-500">Select any topic and HSK level to launch a structured step-by-step masterclass with Panda Laoshi.</p>
            
            <div class="space-y-2">
              <label class="block text-xs font-bold text-slate-600">Select HSK Level:</label>
              <select id="ai-lesson-level" class="w-full p-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold">
                <option value="1">HSK Level 1 (Foundational)</option>
                <option value="2">HSK Level 2 (Elementary)</option>
                <option value="3">HSK Level 3 (Intermediate)</option>
                <option value="4">HSK Level 4 (Upper Intermediate)</option>
              </select>
            </div>

            <div class="space-y-2">
              <label class="block text-xs font-bold text-slate-600">Select Topic:</label>
              <select id="ai-lesson-topic" class="w-full p-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold">
                <!-- Dynamically populated -->
              </select>
            </div>

            <button onclick="generateStructuredTopicLesson()" class="w-full bg-brand-500 hover:bg-brand-600 text-white font-extrabold text-xs py-2.5 rounded-xl border-b-4 border-brand-700 btn-3d flex items-center justify-center gap-2">
              <i class="fa-solid fa-book-open"></i> Launch Topic Lesson
            </button>
          </div>

          <!-- Quick Chat Prompts -->
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-2">
            <h4 class="text-xs font-extrabold text-slate-500 uppercase tracking-wider">Quick Prompts</h4>
            <div class="flex flex-col gap-1.5">
              <button onclick="sendQuickPrompt('Explain the radical origins for words in this topic')" class="text-left bg-slate-50 hover:bg-brand-50 text-slate-700 hover:text-brand-700 p-2 rounded-xl text-xs font-medium border border-slate-200 transition">
                🧩 "Explain the radical origins of key words"
              </button>
              <button onclick="sendQuickPrompt('Give me 3 practical Chinese cultural etiquette tips for this topic')" class="text-left bg-slate-50 hover:bg-brand-50 text-slate-700 hover:text-brand-700 p-2 rounded-xl text-xs font-medium border border-slate-200 transition">
                🏮 "Give me 3 real cultural tips for this topic"
              </button>
              <button onclick="sendQuickPrompt('What are the most common grammar mistakes foreigners make here?')" class="text-left bg-slate-50 hover:bg-brand-50 text-slate-700 hover:text-brand-700 p-2 rounded-xl text-xs font-medium border border-slate-200 transition">
                ⚠️ "What are common foreigner grammar mistakes?"
              </button>
              <button onclick="sendQuickPrompt('Quiz me with 3 rapid questions on this topic')" class="text-left bg-slate-50 hover:bg-brand-50 text-slate-700 hover:text-brand-700 p-2 rounded-xl text-xs font-medium border border-slate-200 transition">
                ⚡ "Quiz me with 3 quick questions"
              </button>
            </div>
          </div>
        </div>

        <!-- Right Column: Panda Laoshi Interactive Chat & Lesson Canvas -->
        <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col h-[600px] overflow-hidden">
          
          <!-- Chat Header with Panda SVG -->
          <div class="bg-brand-50 border-b border-brand-100 p-3 flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 bg-white rounded-full p-1 border-2 border-brand-500 shadow-inner">
                <svg viewBox="0 0 100 100" class="w-full h-full">
                  <circle cx="22" cy="22" r="14" fill="#2d3748" />
                  <circle cx="78" cy="22" r="14" fill="#2d3748" />
                  <circle cx="50" cy="52" r="38" fill="#ffffff" stroke="#e2e8f0" stroke-width="2" />
                  <ellipse cx="33" cy="48" rx="11" ry="14" fill="#2d3748" transform="rotate(-15 33 48)" />
                  <ellipse cx="67" cy="48" rx="11" ry="14" fill="#2d3748" transform="rotate(15 67 48)" />
